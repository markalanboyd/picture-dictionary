{
  "manifest_version": 2,
  "name": "Picture Dictionary",
  "version": "0.1",
  "description": "Highlight a word and see pictures of it instead of a definition.",
  "browser_specific_settings": {
    "gecko": { "id": "picture-dictionary@example.local" }
  },
  "permissions": [
    "storage",
    "https://duckduckgo.com/*",
    "https://external-content.duckduckgo.com/*",
    "https://api.openverse.org/*"
  ],
  "background": { "scripts": ["background.js"] },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "options_ui": { "page": "options.html" }
}
